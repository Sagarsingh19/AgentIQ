# Required for the hosted provider adapters. Never commit actual values.
TAVILY_API_KEY=
GROQ_API_KEY=

# Safe defaults for the first release.
AGENTIQ_MAX_SOURCES=5
AGENTIQ_MAX_QUERY_LENGTH=500
LLM_MODEL=llama-3.3-70b-versatile

# Supabase: publishable key may be used by a future browser client; service role is server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Server-only HMAC key used to protect query hashes stored in audit metadata.
AGENTIQ_AUDIT_HMAC_KEY=
